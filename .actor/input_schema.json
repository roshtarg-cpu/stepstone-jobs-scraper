{
  "title": "Stepstone Jobs Scraper Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "searchQuery": {
      "title": "Search Query",
      "type": "string",
      "description": "Job search keywords (e.g., 'python developer', 'sales manager')",
      "editor": "textfield",
      "default": "python developer",
      "prefill": "software engineer"
    },
    "location": {
      "title": "Location",
      "type": "string",
      "description": "City or region (optional, e.g., 'Berlin', 'Munich')",
      "editor": "textfield"
    },
    "maxResults": {
      "title": "Max Results",
      "type": "integer",
      "description": "Maximum number of job listings to scrape",
      "editor": "number",
      "default": 50,
      "prefill": 10,
      "minimum": 1,
      "maximum": 1000
    },
    "proxyConfiguration": {
      "title": "Proxy Configuration",
      "type": "object",
      "description": "Proxy settings for bypassing blocks",
      "editor": "proxy",
      "prefill": {
        "useApifyProxy": true,
        "apifyProxyGroups": ["RESIDENTIAL"]
      }
    }
  },
  "required": ["searchQuery"]
}
